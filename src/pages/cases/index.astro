---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CaseCard from "../../components/CaseCard.astro";
import CTABlock from "../../components/CTABlock.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../utils/url";

const all = await getCollection("cases", ({ data }) => !data.draft);
all.sort((a, b) => (a.data.sortOrder ?? 100) - (b.data.sortOrder ?? 100));

const breadcrumbs = [
  { name: "Главная", url: "/" },
  { name: "Кейсы", url: "/cases" },
];

// Уникальные индустрии для фильтра
const industries = Array.from(new Set(all.map((c) => c.data.industry)));
const industryRu: Record<string, string> = {
  medical: "Медицина", realty: "Недвижимость", ecommerce: "E-commerce",
  education: "Образование", b2b: "B2B", logistics: "Логистика", other: "Прочее",
};
---
<BaseLayout
  title="Кейсы IMTEN — реальные проекты с цифрами"
  description="Портфолио digital-агентства IMTEN: контекстная реклама, SEO, аналитика. Кейсы в медицине, недвижимости, e-commerce, EdTech, логистике."
>
  <Breadcrumbs items={breadcrumbs} />
  <section class="hero">
    <div class="container">
      <h1>Кейсы</h1>
      <p class="hero__sub">Реальные проекты с реальными цифрами. Часть клиентов под NDA — называем только индустрию и метрики.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px;">
        <a href={withBase("/cases")} class="btn btn--secondary">Все</a>
        {industries.map((i) => (
          <a href={withBase(`/cases?industry=${i}`)} class="btn btn--ghost" data-industry-filter={i}>{industryRu[i] || i}</a>
        ))}
      </div>
      <div class="grid grid--2" id="cases-grid">
        {all.map((c) => (
          <div data-industry={c.data.industry}>
            <CaseCard
              href={`/cases/${c.slug}`}
              title={c.data.title}
              industry={c.data.industry}
              period={c.data.period}
              summary={c.data.summary}
              metrics={c.data.hero?.metrics?.slice(0, 3)}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABlock />

  <script>
    // Простой клиентский фильтр по индустрии из ?industry=...
    const params = new URLSearchParams(window.location.search);
    const ind = params.get("industry");
    if (ind) {
      document.querySelectorAll("#cases-grid > div").forEach((el: any) => {
        if (el.dataset.industry !== ind) el.style.display = "none";
      });
    }
  </script>
</BaseLayout>
