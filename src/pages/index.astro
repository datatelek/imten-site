---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CaseCard from "../components/CaseCard.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTABlock from "../components/CTABlock.astro";
import { getEntry, getCollection } from "astro:content";
import { withBase } from "../utils/url";

const entry = await getEntry("pages", "_index");
if (!entry) throw new Error("pages/_index.md not found");
const data = entry.data;
const { Content } = await entry.render();

// Подгружаем featured cases
const cases = await getCollection("cases", ({ data }) => !data.draft);
const featuredSlugs = data.featuredCases || [];
const featured = featuredSlugs
  .map((s) => cases.find((c) => c.slug === s))
  .filter(Boolean) as any[];
---
<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  canonical={data.seo.canonical}
  ogImage={data.seo.ogImage}
>
  <Hero {...data.hero!} />

  {data.serviceCards && (
    <section class="section">
      <div class="container">
        <div class="section__header">
          <h2>Услуги</h2>
          <p>Полный спектр digital-маркетинга для среднего и крупного бизнеса.</p>
        </div>
        <div class="grid grid--3">
          {data.serviceCards.map((s) => <ServiceCard {...s} />)}
        </div>
      </div>
    </section>
  )}

  {featured.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section__header">
          <h2>Кейсы</h2>
          <p>Реальные результаты в нишах медицины, недвижимости, e-commerce, EdTech и логистики.</p>
        </div>
        <div class="grid grid--2">
          {featured.map((c) => (
            <CaseCard
              href={`/cases/${c.slug}`}
              title={c.data.title}
              industry={c.data.industry}
              period={c.data.period}
              summary={c.data.summary}
              metrics={c.data.hero?.metrics?.slice(0, 3)}
            />
          ))}
        </div>
        <div style="text-align:center;margin-top:36px;">
          <a href={withBase("/cases")} class="btn btn--secondary btn--lg">Все кейсы →</a>
        </div>
      </div>
    </section>
  )}

  {data.faq && data.faq.length > 0 && (
    <section class="section">
      <div class="container-narrow">
        <div class="section__header">
          <h2>Частые вопросы</h2>
        </div>
        <FAQAccordion items={data.faq} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container-narrow">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  <CTABlock />
</BaseLayout>
