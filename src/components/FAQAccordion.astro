---
// Zero-JS аккордеон на <details>. Дополнительно генерирует FAQPage JSON-LD.
import Schema from "./Schema.astro";
import { faqLd } from "../utils/schema-generators";
export interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items?.length > 0 && (
  <>
    <div class="faq">
      {items.map((it) => (
        <details>
          <summary>{it.q}</summary>
          <div class="faq__answer" set:html={it.a.replace(/\n/g, "<br>")} />
        </details>
      ))}
    </div>
    <Schema items={[faqLd(items)]} />
  </>
)}
