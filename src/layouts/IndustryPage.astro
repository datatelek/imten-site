---
// Шаблон для страниц индустрий. Структура та же, что и у услуги,
// но без блока «Цены» (зависят от ниши) и с подбором кейсов по industry.
import BaseLayout from "./BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Pains from "../components/Pains.astro";
import Included from "../components/Included.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CaseCard from "../components/CaseCard.astro";
import CTABlock from "../components/CTABlock.astro";
import { getCollection } from "astro:content";

export interface Props {
  entry: any;
  industryKey: string;
  breadcrumbs: { name: string; url: string }[];
}
const { entry, industryKey, breadcrumbs } = Astro.props;
const data = entry.data;
const { Content } = await entry.render();

const all = await getCollection("cases", ({ data }) => !data.draft);
const related = all.filter((c) => c.data.industry === industryKey).slice(0, 4);
---
<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  canonical={data.seo.canonical}
  ogImage={data.seo.ogImage}
>
  <Breadcrumbs items={breadcrumbs} />
  {data.hero && <Hero {...data.hero} />}

  {data.pains?.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section__header"><h2>Специфика ниши</h2></div>
        <Pains items={data.pains} />
      </div>
    </section>
  )}

  {data.included?.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section__header"><h2>Что мы делаем для этой ниши</h2></div>
        <Included items={data.included} />
      </div>
    </section>
  )}

  {data.process?.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section__header"><h2>Как мы работаем</h2></div>
        <ProcessSteps steps={data.process} />
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section__header"><h2>Кейсы в этой нише</h2></div>
        <div class="grid grid--2">
          {related.map((c) => (
            <CaseCard
              href={`/cases/${c.slug}`}
              title={c.data.title}
              industry={c.data.industry}
              period={c.data.period}
              summary={c.data.summary}
              metrics={c.data.hero?.metrics?.slice(0, 3)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {data.faq?.length > 0 && (
    <section class="section section--alt">
      <div class="container-narrow">
        <div class="section__header"><h2>Частые вопросы</h2></div>
        <FAQAccordion items={data.faq} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container-narrow">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  <CTABlock />
</BaseLayout>
